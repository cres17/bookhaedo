import{readFile,open,writeFile}from'node:fs/promises';import{randomUUID}from'node:crypto';import{spawn}from'node:child_process';import{pathToFileURL}from'node:url';
const [root,target,out]=process.argv.slice(2);if(!root||!target||!out)throw Error('Usage: runner.mts ORIGINAL_REPO DISPOSABLE_CLONE OUTPUT_DIR');const imp=(p:string)=>import(pathToFileURL(root+'/'+p).href);const{pool}=await imp('server/db.ts');const{runMigrations}=await imp('server/migrations.ts');const{default:pg}=await imp('node_modules/pg/lib/index.js');const name='bookhaedo_drift_probe_'+randomUUID().replaceAll('-','');let fresh:any,created=false;const results:any[]=[];
try{await pool.query(`CREATE DATABASE "${name}"`);created=true;const url=new URL(pool.options.connectionString);url.pathname='/'+name;fresh=new pg.Pool({connectionString:url.toString()});await fresh.query(await readFile(root+'/db/schema.sql','utf8'));await runMigrations(fresh);const env={...process.env,DATABASE_URL:url.toString(),NODE_ENV:'test',APP_ORIGINS:'http://127.0.0.1:5273,http://localhost:5273'};
for(const [label,args]of [['contract-probe',['node_modules/vitest/vitest.mjs','run','tests/drift-contract-probe.test.ts']],['browser-probe',['node_modules/@playwright/test/cli.js','test','tests/e2e/drift-boundary-probe.spec.ts','--config','playwright.probe.config.ts']]]){
 const file=await open(out+'/'+label+'.log','w');try{const code=await new Promise((resolve,reject)=>{const p=spawn('node',args,{cwd:target,env,stdio:['ignore',file.fd,file.fd]});p.once('error',reject);p.once('close',resolve)});results.push({label,code});console.log(label,code)}finally{await file.close()}
}
}finally{await fresh?.end();if(created)await pool.query(`DROP DATABASE "${name}"`);await pool.end();await writeFile(out+'/boundary-probe-results.json',JSON.stringify({results,disposableDatabaseRemoved:true},null,2));}
