{
  "name": "bookhaedo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VUE \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vue-tsc -p tsconfig.vue.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "vue-tsc -p tsconfig.vue.json",
    "lint": "eslint server shared frontend/src tests",
    "format": "prettier --write \"{server,shared,frontend/src,tests}/**/*.{ts,vue}\"",
    "format:check": "prettier --check \"{server,shared,frontend/src,tests}/**/*.{ts,vue}\"",
    "spec:generate": "node scripts/write-api-spec.mjs",
    "spec:check": "node scripts/write-api-spec.mjs --check && node scripts/check-dbml.mjs",
    "db:init": "tsx scripts/init-db.ts",
    "test:ci": "vitest run --config vitest.config.ts tests/domain.test.ts tests/bookhaedo.test.ts tests/improvements.test.ts tests/map-focus.test.ts tests/place-dedupe.test.ts tests/website-check.test.ts tests/reliability.test.ts tests/concurrency.test.ts tests/search-assist.test.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "data:setup": "python3 -m venv .venv-data && .venv-data/bin/python -m pip install -r requirements-data.txt",
    "data:prepare": ".venv-data/bin/python scripts/prepare_hokkaido_data.py",
    "db:up": "docker compose up -d db",
    "data:load": ".venv-data/bin/python scripts/load_postgis.py"
  },
  "engines": {"node": "^22.13.0 || ^24.0.0 || >=26.0.0"},
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dbml/core": "^10.1.1",
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.11.0",
    "js-yaml": "^5.4.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
