# Database (local Docker PostgreSQL + PostGIS)
DATABASE_URL="postgresql://kita_plan:kita_plan_local@localhost:5433/kita_plan"

# Vue browser key (existing .env value is supported as-is)
VITE_GOOGLE_MAPS_API_KEY=""
# Development only: when empty, the server reads the VITE key above.
# Production requires a distinct server-specific key.
GOOGLE_MAPS_SERVER_API_KEY=""
API_PORT=3001
APP_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
# Development only: public demo. Set your own/licensed Valhalla endpoint in production.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
API_HOST=127.0.0.1
# Production requires DATABASE_URL, HTTPS APP_ORIGINS, a distinct server Google key
# and a self-hosted/licensed Valhalla URL. Use API_HOST=0.0.0.0 behind your ingress.
