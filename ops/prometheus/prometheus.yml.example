global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - /etc/prometheus/alerts.yml
scrape_configs:
  - job_name: bookhaedo-api
    metrics_path: /internal/metrics
    bearer_token_file: /run/secrets/bookhaedo_metrics_token
    static_configs:
      - targets: ['bookhaedo-api:3001']
